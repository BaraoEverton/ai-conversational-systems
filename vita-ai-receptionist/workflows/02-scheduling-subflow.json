    {
      "parameters": {
        "jsCode": "const pedido = $('Loop Over Items').item.json;\n\nconst data_consultada =\n  pedido.data_consultada ||\n  (typeof pedido.datas === 'string' ? pedido.datas : null) ||\n  pedido.data_inicio;\n\nif (!data_consultada || !pedido.hora_inicio || !pedido.hora_fim) {\n  throw new Error('Data ou janela de horário não informada.');\n}\n\nconst paraMinutos = valor => {\n  const resultado = String(valor).match(\n    /(?:T|^)(\\d{2}):(\\d{2})/\n  );\n\n  if (!resultado) {\n    throw new Error(`Horário inválido: ${valor}`);\n  }\n\n  return Number(resultado[1]) * 60 +\n    Number(resultado[2]);\n};\n\nconst paraHora = minutos =>\n  `${String(Math.floor(minutos / 60)).padStart(2, '0')}:` +\n  `${String(minutos % 60).padStart(2, '0')}`;\n\nconst inicioJanela =\n  paraMinutos(pedido.hora_inicio);\n\nconst fimJanela =\n  paraMinutos(pedido.hora_fim);\n\nif (fimJanela <= inicioJanela) {\n  throw new Error('A janela consultada é inválida.');\n}\n\nconst minutos =\n  Array(fimJanela - inicioJanela).fill(true);\n\nconst resultados =\n  $input.all().map(item => item.json ?? {});\n\nif (\n  resultados.some(item =>\n    item.error || item.errorMessage\n  )\n) {\n  throw new Error(\n    'Falha ao consultar uma das agendas.'\n  );\n}\n\nconst bloqueios = [\n  ...resultados\n    .filter(item => item.start && item.end)\n    .map(item => ({\n      inicio: item.start,\n      fim: item.end\n    })),\n\n  {\n    inicio: '12:00',\n    fim: '13:00'\n  }\n];\n\nfor (const bloqueio of bloqueios) {\n  const inicio = Math.max(\n    paraMinutos(bloqueio.inicio),\n    inicioJanela\n  );\n\n  const fim = Math.min(\n    paraMinutos(bloqueio.fim),\n    fimJanela\n  );\n\n  for (let minuto = inicio; minuto < fim; minuto++) {\n    minutos[minuto - inicioJanela] = false;\n  }\n}\n\nconst criarIntervalos = estado => {\n  const intervalos = [];\n  let inicio = null;\n\n  for (let indice = 0; indice <= minutos.length; indice++) {\n    const corresponde =\n      indice < minutos.length &&\n      minutos[indice] === estado;\n\n    if (corresponde && inicio === null) {\n      inicio = indice;\n    }\n\n    if (!corresponde && inicio !== null) {\n      intervalos.push({\n        inicio: paraHora(inicioJanela + inicio),\n        fim: paraHora(inicioJanela + indice)\n      });\n\n      inicio = null;\n    }\n  }\n\n  return intervalos;\n};\n\nconst horarios_ocupados =\n  criarIntervalos(false);\n\nconst horarios_livres =\n  criarIntervalos(true);\n\nreturn [\n  {\n    json: {\n      tipo_consulta:\n        pedido.tipo_consulta,\n\n      periodo_consultado: {\n        data_inicio: data_consultada,\n        data_fim: data_consultada\n      },\n\n      janela_consultada: {\n        inicio: pedido.hora_inicio,\n        fim: pedido.hora_fim\n      },\n\n      horarios_ocupados,\n\n      horarios_livres:\n        horarios_livres.length\n          ? horarios_livres\n          : ['intervalo_indisponivel']\n    }\n  }\n];"
      },
